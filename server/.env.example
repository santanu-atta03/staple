# Required authentication and persistence configuration.
MONGO_URI=mongodb://127.0.0.1:27017/staple
# Optional resolver override for Node.js SRV lookup (comma-separated IPs).
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-bytes
FRONTEND_URL=http://localhost:5173

# OTP email delivery. OTP_HMAC_SECRET must be a separate random secret (32+ bytes).
# SMTP_FROM may be omitted when SMTP_USER is the authorized sender address.
OTP_HMAC_SECRET=replace-with-a-separate-random-secret-at-least-32-bytes
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# Provider client identifiers configured in the provider consoles.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=http://localhost:5173/

# Optional storage configuration; without Cloudinary, authenticated uploads use local storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
